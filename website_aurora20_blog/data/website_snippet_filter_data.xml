<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Extra data source for Odoo's "Blog Posts" blocks. Posts of one blog
         (category) are picked with the block's own "Blog" option. -->
    <record id="dynamic_snippet_featured_blog_post_filter" model="ir.filters">
        <field name="name">Featured Blog Posts</field>
        <field name="model_id">blog.post</field>
        <field name="user_ids" eval="False"/>
        <field name="domain">[('published_date', '&lt;=', 'now'), ('aurora_is_featured', '=', True)]</field>
        <field name="sort">["published_date desc"]</field>
        <field name="action_id" ref="website.action_website"/>
    </record>
    <record id="dynamic_filter_featured_blog_posts" model="website.snippet.filter">
        <field name="name">Featured Blog Posts</field>
        <field name="filter_id" ref="dynamic_snippet_featured_blog_post_filter"/>
        <field name="field_names">name,teaser,subtitle</field>
        <field name="limit" eval="16"/>
    </record>
</odoo>
