<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Aurora card layout, offered in the "Template" option of Odoo's
         "Blog Posts" blocks (grid and carousel). -->
    <template id="dynamic_filter_template_blog_post_aurora_card" name="Aurora Card"
              data-extra-classes="g-4"
              data-column-classes="col-12 col-sm-6 col-lg-4"
              data-number-of-elements="3"
              data-number-of-elements-sm="1">
        <div t-foreach="records" t-as="data" class="s_blog_posts_post o_aurora_blog_card w-100">
            <t t-set="record" t-value="data['_record']"/>
            <article class="card h-100 border-0 overflow-hidden">
                <a class="o_aurora_blog_card_cover d-block ratio ratio-16x9 overflow-hidden"
                   t-att-href="data['call_to_action_url']" tabindex="-1" aria-hidden="true">
                    <t t-call="website.record_cover"
                       _record="record"
                       additionnal_classes.f="position-absolute w-100 h-100 bg-600 o_snippet_not_selectable"/>
                </a>
                <div class="card-body d-flex flex-column px-0">
                    <div class="o_aurora_blog_card_meta d-flex flex-wrap align-items-center gap-2 small text-muted mb-2">
                        <a t-if="record.blog_id" class="o_aurora_blog_card_category text-uppercase fw-semibold text-decoration-none"
                           t-att-href="'/blog/%s' % record.blog_id.id" t-out="record.blog_id.name"/>
                        <span t-if="record.published_date" t-field="record.published_date" t-options='{"format": "MMM d, yyyy"}'/>
                        <span t-if="record.aurora_reading_time">
                            <t t-out="record.aurora_reading_time"/> min read
                        </span>
                    </div>
                    <h3 class="h5 mb-2">
                        <a class="stretched-link text-reset text-decoration-none" t-att-href="data['call_to_action_url']"
                           t-field="record.name"/>
                    </h3>
                    <p t-if="record.teaser" class="o_line_clamp small text-muted mb-0" t-field="record.teaser"/>
                    <div t-if="is_sample" class="h6 o_ribbon_right bg-primary text-uppercase">Sample</div>
                </div>
            </article>
        </div>
    </template>

    <!-- Ready-made "Latest Stories" block: Odoo's Blog Posts block with the
         Aurora card and the latest posts. Everything stays editable. -->
    <template id="s_aurora_blog_posts" name="Aurora Latest Stories">
        <t t-set="aurora_filter" t-value="env.ref('website_blog.dynamic_filter_latest_blog_posts', raise_if_not_found=False)"/>
        <section data-snippet="s_blog_posts"
                 data-name="Blog Posts"
                 class="s_blog_posts s_dynamic_snippet_blog_posts s_blog_post_aurora_card s_dynamic o_dynamic_snippet_loading pt64 pb64"
                 t-att-data-filter-id="aurora_filter.id if aurora_filter else None"
                 data-template-key="website_aurora20_blog.dynamic_filter_template_blog_post_aurora_card"
                 data-number-of-records="3"
                 data-custom-template-data="{}">
            <div class="s_dynamic_snippet_container container">
                <div class="row s_nb_column_fixed">
                    <section class="d-flex justify-content-between flex-column flex-md-row s_dynamic_snippet_title oe_unremovable oe_unmovable mb-lg-0 pb-3 pb-md-0 s_col_no_resize">
                        <div>
                            <h2 class="h3">Latest stories</h2>
                            <p class="lead">Guides, ideas and news from our team.</p>
                        </div>
                        <div><a class="btn btn-outline-primary" href="/blog">All articles</a></div>
                    </section>
                    <section class="s_dynamic_snippet_content oe_unremovable oe_unmovable o_not_editable col s_col_no_resize">
                        <div class="css_non_editable_mode_hidden">
                            <div class="missing_option_warning alert alert-info fade show d-none d-print-none rounded-0">
                                Publish a blog post, or choose another source in the block options, to display articles here.
                            </div>
                        </div>
                        <div class="dynamic_snippet_template"/>
                    </section>
                </div>
            </div>
        </section>
    </template>

    <template id="snippets" inherit_id="website.snippets" name="Aurora blog building blocks">
        <xpath expr="//snippets[@id='snippet_structure']" position="inside">
            <t t-snippet="website_aurora20_blog.s_aurora_blog_posts" string="Latest Stories" group="aurora">
                <keywords>blog, articles, posts, news, stories, aurora</keywords>
            </t>
        </xpath>
    </template>
</odoo>
